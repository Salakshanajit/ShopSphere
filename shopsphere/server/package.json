{
  "name": "shopsphere-server",
  "version": "1.0.0",
  "private": true,
  "description": "ShopSphere REST API (Express + MySQL + JWT)",
  "main": "src/server.js",
  "scripts": {
    "setup": "node scripts/setupEnv.js",
    "db:init": "node scripts/initDb.js",
    "db:reset": "node scripts/initDb.js --reset",
    "create-admin": "node scripts/createAdmin.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
