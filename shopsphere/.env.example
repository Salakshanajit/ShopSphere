# ShopSphere environment settings
# Copy this file to ".env" (or run `npm run setup` inside the server folder,
# which does it for you and generates a random JWT_SECRET).
# NEVER commit your real .env file or share its contents.

# ---------- Server ----------
PORT=5000
# Address of the React app (used for CORS). Several origins can be separated by commas.
CLIENT_URL=http://localhost:5173

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Put your own MySQL password here (leave empty only if your MySQL user has no password)
DB_PASSWORD=
# Keep this as "shopsphere": it must match database/schema.sql
DB_NAME=shopsphere

# ---------- JWT ----------
# Long random text used to sign login tokens. Leave empty and run `npm run setup`
# to have one generated for you.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- First admin account (used only by `npm run create-admin`) ----------
# Name and email are suggestions shown as defaults in the prompt.
# Leave ADMIN_PASSWORD empty so the script asks you for it (recommended).
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@shopsphere.local
ADMIN_PASSWORD=
