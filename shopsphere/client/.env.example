# Optional. The defaults work with the backend on port 5000, so you normally do not need a .env file here.

# Where Vite forwards "/api" requests during development
# VITE_PROXY_TARGET=http://localhost:5000

# Use a full URL only if the API is hosted somewhere else (then CLIENT_URL on the server must allow this site)
# VITE_API_URL=http://localhost:5000/api
